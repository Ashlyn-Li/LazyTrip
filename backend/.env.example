# Copy this file to .env for local-only settings.
LAZYTRIP_ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future LLM provider settings. Keep real values in .env only.
ITINERARY_GENERATOR=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# Backward-compatible Portkey names are also read locally.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://portkey.bain.dev/v1
PORTKEY_MODEL=@personal-openai/gpt-5.4
